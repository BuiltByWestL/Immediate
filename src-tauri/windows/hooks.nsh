  !insertmacro IMMEDIATE_UNASSOC "srt" "Immediate.Document"
  !insertmacro IMMEDIATE_UNASSOC "vtt" "Immediate.Document"
  !insertmacro IMMEDIATE_UNASSOC "pdf" "Immediate.Document"
  !insertmacro IMMEDIATE_UNASSOC "xlsx" "Immediate.Document"
  !insertmacro IMMEDIATE_UNASSOC "xls" "Immediate.Document"
  !insertmacro IMMEDIATE_UNASSOC "ods" "Immediate.Document"
  !insertmacro IMMEDIATE_UNASSOC "docx" "Immediate.Document"
  DeleteRegKey HKCU "Software\Classes\Immediate.Image"
  DeleteRegKey HKCU "Software\Classes\Immediate.Video"
  DeleteRegKey HKCU "Software\Classes\Immediate.Audio"
  DeleteRegKey HKCU "Software\Classes\Immediate.Document"
  DeleteRegKey HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe"
  DeleteRegValue HKCU "Software\RegisteredApplications" "Immediate"
  DeleteRegKey HKCU "Software\Immediate"
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend

; Generated by scripts/gen-associations.mjs from src/formats.json. Do not edit by hand.
;
; Registers Immediate under "Open with" and adds a right-click entry ("Edit with Immediate")
; for every supported type, per user. It never changes which app opens a file by default:
; that stays the user's choice (Settings > Apps > Default apps lists Immediate).

!macro IMMEDIATE_PROGID PROGID NAME
  WriteRegStr HKCU "Software\Classes\${PROGID}" "" "${NAME}"
  WriteRegStr HKCU "Software\Classes\${PROGID}\DefaultIcon" "" "$INSTDIR\${MAINBINARYNAME}.exe,0"
  WriteRegStr HKCU "Software\Classes\${PROGID}\shell\open\command" "" '"$INSTDIR\${MAINBINARYNAME}.exe" "%1"'
!macroend

!macro IMMEDIATE_OPENWITH EXT PROGID
  WriteRegStr HKCU "Software\Classes\.${EXT}\OpenWithProgids" "${PROGID}" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".${EXT}" ""
  WriteRegStr HKCU "Software\Immediate\Capabilities\FileAssociations" ".${EXT}" "${PROGID}"
!macroend

!macro IMMEDIATE_VERB EXT LABEL
  WriteRegStr HKCU "Software\Classes\SystemFileAssociations\.${EXT}\shell\Immediate" "" "${LABEL}"
  WriteRegStr HKCU "Software\Classes\SystemFileAssociations\.${EXT}\shell\Immediate" "Icon" "$INSTDIR\${MAINBINARYNAME}.exe,0"
  WriteRegStr HKCU "Software\Classes\SystemFileAssociations\.${EXT}\shell\Immediate" "MultiSelectModel" "Player"
  WriteRegStr HKCU "Software\Classes\SystemFileAssociations\.${EXT}\shell\Immediate\command" "" '"$INSTDIR\${MAINBINARYNAME}.exe" "%1"'
!macroend

!macro IMMEDIATE_UNASSOC EXT PROGID
  DeleteRegValue HKCU "Software\Classes\.${EXT}\OpenWithProgids" "${PROGID}"
  DeleteRegKey /ifempty HKCU "Software\Classes\.${EXT}\OpenWithProgids"
  DeleteRegKey /ifempty HKCU "Software\Classes\.${EXT}"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.${EXT}\shell\Immediate"
!macroend

!macro NSIS_HOOK_PREINSTALL
  Delete "$INSTDIR\immediate_menu.dll.old"
  IfFileExists "$INSTDIR\immediate_menu.dll" 0 +2
  Rename "$INSTDIR\immediate_menu.dll" "$INSTDIR\immediate_menu.dll.old"
!macroend

!macro NSIS_HOOK_POSTINSTALL
  nsExec::Exec `powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "if (Get-AppxPackage -Name BuiltByWestL.Immediate.Menu) { Add-AppxPackage -Path '$INSTDIR\immediate-menu.msix' -ExternalLocation '$INSTDIR' }"`
  !insertmacro IMMEDIATE_PROGID "Immediate.Image" "Image file"
  !insertmacro IMMEDIATE_PROGID "Immediate.Video" "Video file"
  !insertmacro IMMEDIATE_PROGID "Immediate.Audio" "Audio file"
  !insertmacro IMMEDIATE_PROGID "Immediate.Document" "Document file"
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe" "FriendlyAppName" "Immediate"
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\DefaultIcon" "" "$INSTDIR\${MAINBINARYNAME}.exe,0"
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\shell\open\command" "" '"$INSTDIR\${MAINBINARYNAME}.exe" "%1"'
  WriteRegStr HKCU "Software\Immediate\Capabilities" "ApplicationName" "Immediate"
  WriteRegStr HKCU "Software\Immediate\Capabilities" "ApplicationDescription" "Open any media file, make a quick edit, save a file."
  WriteRegStr HKCU "Software\RegisteredApplications" "Immediate" "Software\Immediate\Capabilities"
  !insertmacro IMMEDIATE_OPENWITH "jpg" "Immediate.Image"
  !insertmacro IMMEDIATE_VERB "jpg" "Edit with Immediate"
  !insertmacro IMMEDIATE_OPENWITH "jpeg" "Immediate.Image"
  !insertmacro IMMEDIATE_VERB "jpeg" "Edit with Immediate"

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Every Immediate window",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
